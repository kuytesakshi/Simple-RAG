# Backend env — copy to backend/.env and fill in.
# Used locally (pydantic-settings) and in Docker (compose env_file + --env-file for interpolation).
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.1-8b-instant
# In Docker, host must be `db`. Locally (no Docker), use localhost.
DATABASE_URL=postgresql+psycopg://raguser:ragpass@db:5432/ragdb
JWT_SECRET=change-me-in-env
# In Docker this is /app/Data (mounted from ./backend/Data). Locally it can be ./Data
DATA_DIR=/app/Data
# Port tuning (backend + postgres + adminer)
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb
POSTGRES_PORT=5432
BACKEND_PORT=8000
ADMINER_PORT=8080
# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000
# RAG chunking (step 2)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# RAG retrieval: top-k chunks per query
RETRIEVAL_TOP_K=4
