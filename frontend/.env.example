# Frontend tuning — copy to frontend/.env.local. No root .env is used.
# Port the browser uses to reach the backend. Must match BACKEND_PORT in backend/.env
NEXT_PUBLIC_API_URL=http://localhost:8000
# Port for `npm run dev` (Next.js respects PORT)
PORT=3000
# Base path all pages render under (e.g. /rag -> /rag/login, /rag/chat). Empty for root.
NEXT_PUBLIC_BASE_PATH=/rag
